rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users: Owner-only access
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Twins: Measurements & shape parameters readable/writable ONLY by owner
    match /twins/{twinId} {
      allow read: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
    }

    // 3. Jobs & Rounds: Processing jobs owned by the requesting user
    match /jobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;

      match /rounds/{roundId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/jobs/$(jobId)).data.user_id == request.auth.uid;
      }
    }

    // 4. Wardrobe: User personal wardrobe items
    match /wardrobe/{itemId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // 5. Gifts: Accessible only by sender or recipient
    match /gifts/{giftId} {
      allow read: if isAuthenticated() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.recipient_id == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.sender_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.sender_id == request.auth.uid;
    }

    // 6. Consents: two kinds share the collection.
    //    - capture consents (18+, photo retention) carry user_id and are written by the owner;
    //    - store consents (scope "fit_verdict") carry uid and merchant_id. The owner can read them (My twin lists them),
    //      but they are created and revoked only by the API, which issues and checks the signed consent token.
    match /consents/{consentId} {
      allow read: if isAuthenticated() && (resource.data.get('uid', '') == request.auth.uid || resource.data.get('user_id', '') == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.get('scope', '') != 'fit_verdict' && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.get('scope', '') != 'fit_verdict' && resource.data.get('user_id', '') == request.auth.uid;
    }

    // 7. Public/Client-readable catalog collections
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Server-managed only
    }

    match /fits/{fitId} {
      // Consumers can view their own fit verdicts; server generates them
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow write: if false; // Server-managed only
    }

    // 8. Business & Internal Server-only collections
    // (merchants, garments, events, orders, returns, charts, sims)
    match /merchants/{merchantId} {
      allow read, write: if false;
    }
    match /garments/{garmentId} {
      allow read, write: if false;
    }
    match /events/{eventId} {
      allow read, write: if false;
    }
    match /orders/{orderId} {
      allow read, write: if false;
    }
    match /returns/{returnId} {
      allow read, write: if false;
    }
    match /charts/{chartId} {
      allow read, write: if false;
    }
    match /sims/{simId} {
      allow read, write: if false;
    }
    // Unboxing measurements (garment values and an overlay image, never body data): server only.
    match /unboxing_measurements/{id} {
      allow read, write: if false;
    }
    // Store-facing logs and gift requests: server only. fit_queries holds no body data and no user id.
    match /fit_queries/{queryId} {
      allow read, write: if false;
    }
    match /gifts/{giftId} {
      allow read, write: if false;
    }
  }
}
