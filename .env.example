# Copy to .env (gitignored). Never commit real keys.

# LLM backend: auto | ollama | vertex | gemini_api
# (legacy LLM_PROVIDER=gemini|ollama is still honoured when LLM_BACKEND is unset)
LLM_BACKEND=auto

# Ollama (dev backend)
OLLAMA_BASE_URL=https://hbt-ollama-link.internaltoolshbt.workers.dev
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_S=120
# OLLAMA_API_KEY=your-optional-token-if-behind-auth-proxy

# Gemini Developer API key (dev fallback, use sparingly)
GEMINI_API_KEY=
GEMINI_API_MAX_CALLS=30

# Gemini models (Vertex AI / Agent Platform). Pick current IDs in Model Garden; never 1.x or 2.x.
GEMINI_PRO_MODEL=
GEMINI_FLASH_MODEL=
GEMINI_IMAGE_MODEL=
VTO_MODEL=

# Google Cloud (submitted demo uses Vertex)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
REGION=us-central1
BUCKET=your-gcp-storage-bucket
TASKS_QUEUE=fit-jobs-queue

# Service Endpoints (Local & Cloud Run)
API_URL=http://localhost:8000
GEOMETRY_URL=http://localhost:8001
READER_URL=http://localhost:8002

# --- services/api security (apilib/auth.py) ---
# AUTH_MODE=dev makes `current_uid` accept `Bearer dev:<any-uid>` as a signed-in user, with no
# real Firebase token check, and relaxes the CONSENT_JWT_SECRET requirement below. It is for
# local development and tests ONLY. NEVER set AUTH_MODE=dev on a real deployment: main.py's
# validate_security_config() refuses to start if AUTH_MODE=dev is set while running on Cloud Run
# (detected via the K_SERVICE variable every real Cloud Run revision sets automatically) -- so a
# deploy with this left set will fail closed at startup, not silently accept forged logins. Leave
# this unset (not merely "false") in every deployed environment.
AUTH_MODE=dev
# Required whenever AUTH_MODE is not "dev" (i.e. required in every real deployment): signs the
# 30-day merchant consent tokens (apilib/auth.py::issue_consent_token). Must be a random secret
# of at least 32 characters; validate_security_config() refuses to start otherwise. Generate one
# with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"` and set the real value
# only in your deploy environment's own secret store -- never put a real value in this file or
# commit one.
CONSENT_JWT_SECRET=
# Comma-separated origins allowed to call the API's customer/business endpoints from a browser
# (apilib/cors.py's DynamicCORS). Example: https://app.example.com,https://biz.example.com
API_CORS_ORIGINS=http://localhost:5173
# Requests per minute, per merchant key (apilib/fitquery.py) or per signed-in uid (the
# customer-facing /v1/me/fit-from-url), enforced in-memory per Cloud Run instance.
RATE_LIMIT_PER_MIN=60

# --- web build (Vite) ---
# Base URL the web app's apiClient (web/src/lib/api.ts) calls. Leave unset/empty for the Vite dev
# server (requests go through its /api proxy to API_URL above); set to the real API's public URL
# (e.g. https://api.example.com) for a deployed build.
VITE_API_URL=
# Mirrors AUTH_MODE for the frontend: set to "dev" ONLY for local development, to show the
# "Sign in as Demo Shopper" button (web/src/lib/auth.tsx) and send `Bearer dev:<uid>` tokens.
# NEVER set VITE_AUTH_MODE=dev in a deployed build -- unlike backend AUTH_MODE=dev, nothing in
# the frontend build itself can detect a real deployment and refuse to start, so leaving this set
# would ship a working "sign in as anyone" button to real users. The backend's own
# validate_security_config() check (above) is the actual enforcement; this variable controls only
# whether the client OFFERS the shortcut, so it must be unset in every deployed .env this frontend
# is built with.
VITE_AUTH_MODE=dev

# Firebase Web Configuration (server-side; used by services that call Firebase Admin SDKs)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-gcp-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Web Configuration (frontend; read by web/src/lib/firebase.ts via Vite, must be
# duplicated with the VITE_ prefix since Vite only exposes prefixed vars to browser code -- these
# are the public Firebase Web SDK config values, not secrets, but still real per-project values,
# not something to invent)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
