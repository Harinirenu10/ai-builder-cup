# Copy to .env (gitignored). Never commit real keys.

# LLM backend: auto | ollama | vertex | gemini_api
# (legacy LLM_PROVIDER=gemini|ollama is still honoured when LLM_BACKEND is unset)
LLM_BACKEND=auto

# Ollama (dev backend)
OLLAMA_BASE_URL=https://hbt-ollama-link.internaltoolshbt.workers.dev
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_S=120
# OLLAMA_API_KEY=your-optional-token-if-behind-auth-proxy

# Gemini Developer API key (dev fallback, use sparingly)
GEMINI_API_KEY=
GEMINI_API_MAX_CALLS=30

# Gemini models (Vertex AI / Agent Platform). Pick current IDs in Model Garden; never 1.x or 2.x.
GEMINI_PRO_MODEL=
GEMINI_FLASH_MODEL=
GEMINI_IMAGE_MODEL=
VTO_MODEL=

# Google Cloud (submitted demo uses Vertex)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
REGION=us-central1
BUCKET=your-gcp-storage-bucket
TASKS_QUEUE=fit-jobs-queue

# Service Endpoints (Local & Cloud Run)
API_URL=http://localhost:8000
GEOMETRY_URL=http://localhost:8001
READER_URL=http://localhost:8002

# Firebase Web Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-gcp-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
