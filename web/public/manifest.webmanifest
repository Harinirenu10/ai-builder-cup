{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Measured Fit - 3D Body Twin & Precision Sizing",
  "short_name": "Measured Fit",
  "description": "Deterministic 3D biometric body twin derived from 4 orthogonal photos with zero-retention raw photos.",
  "start_url": "/app",
  "scope": "/",
  "id": "/app",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#090d16",
  "theme_color": "#0284c7",
  "categories": ["shopping", "lifestyle", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/app",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "4-Photo Capture",
      "short_name": "Capture",
      "description": "Capture 4 orthogonal biometric photos for SMPL fitting",
      "url": "/app?tab=capture",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "3D Twin Viewer",
      "short_name": "3D Twin",
      "description": "Inspect your deterministic 3D avatar & model",
      "url": "/app?tab=twin",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "My Measurements",
      "short_name": "Measurements",
      "description": "View metric zone measurements & ease calibration",
      "url": "/app?tab=measurements",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    }
  ]
}
